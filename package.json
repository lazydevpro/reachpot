{
  "name": "reachpot",
  "private": true,
  "description": "Pro-rata creator campaigns on Portaldot, funded in any native asset",
  "license": "MIT",
  "packageManager": "pnpm@8.6.12",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:contracts": "cd contracts && forge build",
    "test": "pnpm test:contracts && pnpm test:allocation",
    "test:contracts": "cd contracts && forge test",
    "test:allocation": "pnpm --filter @reachpot/allocation test",
    "verify": "pnpm --filter @reachpot/allocation verify",
    "spike": "pnpm --filter @reachpot/scripts exec tsx spike-precompile.ts",
    "chain:up": "scripts/chain/up.sh",
    "chain:down": "scripts/chain/down.sh",
    "accounts": "pnpm --filter @reachpot/scripts exec tsx accounts.ts"
  }
}
