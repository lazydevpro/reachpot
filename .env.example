# Copy to .env (gitignored). Local chain needs none of these: it uses well-known dev accounts.

# --- testnet signers (throwaway keys only) ---
DEPLOYER_PRIVATE_KEY=        # EVM: deploys Reachpot, owner (+ oracle/guardian/brand unless set below)
ORACLE_PRIVATE_KEY=          # EVM: posts payout roots and pushes payouts (keeper)
GUARDIAN_PRIVATE_KEY=        # EVM: can cancel a bad root during the dispute window
BRAND_PRIVATE_KEY=           # EVM: demo brand for scripted runs (receives the demo rUSD/NOVA)
NATIVE_ADMIN_MNEMONIC=       # sr25519: asset/badge admin, TransactionStorage publisher, funds other roles
# CREATOR_MNEMONIC_1/2 are generated by `pnpm e2e --network testnet` on first use.

# --- web app (apps/web reads this root .env on the server) ---
# NEXT_PUBLIC_NETWORK must be set in the shell or apps/web/.env.local (it is inlined into the client bundle).
# NEXT_PUBLIC_NETWORK=testnet
YOUTUBE_API_KEY=             # YouTube Data API v3 key; without it views are simulated (VIEWS_SOURCE=mock)
# VIEWS_SOURCE=mock
KEEPER_SECRET=               # protects POST /api/keeper/tick (defaults to "local-dev" on the local chain)
# KEEPER_INTERVAL_MS=30000
# KEEPER_AUTORUN=0           # disable the in-process keeper loop (e.g. when an external cron calls the tick route)
# ENABLE_DEV_TOOLS=1         # allow /api/dev/views off the local chain (scripted runs only)
